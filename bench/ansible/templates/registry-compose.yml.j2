services:
  registry-fs:
    image: registry:3
    container_name: registry-fs
    restart: unless-stopped
    network_mode: host
    volumes:
      - /etc/registry/config-fs.yml:/etc/distribution/config.yml:ro
      - /mnt/registry-data:/mnt/registry-data
    command: ["serve", "/etc/distribution/config.yml"]

  registry-azure:
    image: registry:3
    container_name: registry-azure
    restart: unless-stopped
    network_mode: host
    volumes:
      - /etc/registry/config-azure.yml:/etc/distribution/config.yml:ro
    command: ["serve", "/etc/distribution/config.yml"]
