version: 0.1
log:
  level: info
  fields:
    service: registry-s3
storage:
  s3:
    region: "{{ s3_region }}"
    bucket: "{{ s3_bucket }}"
    # No accesskey/secretkey: uses EC2 IAM instance profile via instance metadata.
    encrypt: false
    secure: true
    v4auth: true
    chunksize: 5242880
  cache:
    blobdescriptor: inmemory
  delete:
    enabled: true
http:
  addr: :5001
  headers:
    X-Content-Type-Options: [nosniff]
  http2:
    disabled: false
health:
  storagedriver:
    enabled: true
    interval: 10s
    threshold: 3
